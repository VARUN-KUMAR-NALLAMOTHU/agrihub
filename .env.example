# Copy this file to .env and fill in the values. NEVER put real keys in this file.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1

# Optional. Google Weather + Geocoding APIs (needs Google Cloud billing). Leave empty to use the free Open-Meteo service instead.
GOOGLE_API_KEY=

# Gemini key for the chatbot (https://aistudio.google.com/apikey). Run `python3 check_gemini.py` to find a working model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash

# Email OTP - option A (recommended for deployment): Brevo HTTPS API, free 300 emails/day
BREVO_API_KEY=
BREVO_SENDER=

# Email OTP - option B (local only; most free hosts block SMTP): Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
